// Generated by terraingen_add_kernel (cmake/TerrainGenSlang.cmake): applies the kernel
// terraingen::@KERNEL_TYPE@ to a strip of grid rows. Each cell holding data gets ApplyCell at
// its column's x and its row's y, measured from the layer's origin. The host side is
// RunKernel (terraingen/gpu/kernel.h).
#include "@KERNEL_HEADER@"

[[vk::binding(0, 0)]] RWStructuredBuffer<float> heights;
[[vk::binding(1, 0)]] StructuredBuffer<float> xs;
[[vk::binding(2, 0)]] StructuredBuffer<float> ys;
[[vk::binding(3, 0)]] StructuredBuffer<terraingen::@KERNEL_TYPE@> kernels;

static const uint kNoDataNone = 0u;
static const uint kNoDataNan = 1u;

struct Params {
    uint width;
    uint rows;
    uint noData;
    float noDataValue;
    uint firstRow;
};
[[vk::push_constant]] ConstantBuffer<Params> params;

[shader("compute")]
[numthreads(16, 16, 1)]
void main(uint3 id : SV_DispatchThreadID) {
    const uint col = id.x;
    const uint row = id.y;
    if (col >= params.width || row >= params.rows) {
        return;
    }
    const uint i = row * params.width + col;
    const float height = heights[i];
    if (params.noData == kNoDataNan) {
        if (isnan(height)) {
            return;
        }
    } else if (params.noData != kNoDataNone && height == params.noDataValue) {
        return;
    }
    terraingen::CellPosition position = {xs[col], ys[row]};
    heights[i] = terraingen::ApplyCell(kernels[0], height, position);
}
