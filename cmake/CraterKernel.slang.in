// Generated by terraingen_add_kernel (cmake/TerrainGenSlang.cmake) from cmake/CraterKernel.slang.in:
// shapes the craters of terraingen::@KERNEL_TYPE@ into a strip of grid rows. Each cell holding data
// runs ApplyCraterKernel for the craters of its tile, in order, at its offset from each crater's
// centre. The host side is ShapeTilesOnGpu (terraingen/layers/craters/shaping/apply.cpp).
#include "@KERNEL_HEADER@"

[[vk::binding(0, 0)]] RWStructuredBuffer<float> heights;
[[vk::binding(1, 0)]] StructuredBuffer<float> xs;
[[vk::binding(2, 0)]] StructuredBuffer<float> ys;
[[vk::binding(3, 0)]] StructuredBuffer<terraingen::@KERNEL_TYPE@> kernels;
[[vk::binding(4, 0)]] StructuredBuffer<terraingen::CraterRecord> records;
[[vk::binding(5, 0)]] StructuredBuffer<float> data;
// Tiles across, cells per tile side, then the first entry and the entry count of each tile.
[[vk::binding(6, 0)]] StructuredBuffer<uint> tiles;
[[vk::binding(7, 0)]] StructuredBuffer<uint> entries;

static const uint kNoDataNone = 0u;
static const uint kNoDataNan = 1u;

struct Params {
    uint width;
    uint rows;
    uint noData;
    float noDataValue;
    uint firstRow;
};
[[vk::push_constant]] ConstantBuffer<Params> params;

[shader("compute")]
[numthreads(16, 16, 1)]
void main(uint3 id : SV_DispatchThreadID) {
    const uint col = id.x;
    const uint row = id.y;
    if (col >= params.width || row >= params.rows) {
        return;
    }
    const uint i = row * params.width + col;
    float height = heights[i];
    if (params.noData == kNoDataNan) {
        if (isnan(height)) {
            return;
        }
    } else if (params.noData != kNoDataNone && height == params.noDataValue) {
        return;
    }
    const uint side = tiles[1];
    const uint tile = ((params.firstRow + row) / side) * tiles[0] + col / side;
    const uint first = tiles[2 + 2 * tile];
    const uint count = tiles[3 + 2 * tile];
    const float x = xs[col];
    const float y = ys[row];
    for (uint k = first; k < first + count; ++k) {
        const terraingen::CraterRecord crater = records[entries[k]];
        height = terraingen::ApplyCraterKernel(kernels[0], data, crater, height, x - crater.x,
                                               y - crater.y);
    }
    heights[i] = height;
}
