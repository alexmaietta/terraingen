# Doxygen configuration feeding XML to Breathe for the Sphinx C++ API reference.
PROJECT_NAME           = TerrainGen
OUTPUT_DIRECTORY       = _doxygen
INPUT                  = ../terraingen
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/* */python/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
GENERATE_XML           = YES
# Default member values are left out: Sphinx cannot parse designated initializers.
MAX_INITIALIZER_LINES  = 0
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC = NO
