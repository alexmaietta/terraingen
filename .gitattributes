# Normalize line endings for text files
* text=auto eol=lf

# Binary render assets and test fixtures are stored in Git LFS
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
assets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
assets/**/*.otf filter=lfs diff=lfs merge=lfs -text
assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/**/*.bin filter=lfs diff=lfs merge=lfs -text
assets/**/*.obj filter=lfs diff=lfs merge=lfs -text
assets/**/*.ply filter=lfs diff=lfs merge=lfs -text
assets/**/*.stl filter=lfs diff=lfs merge=lfs -text

tests/fixtures/**/*.tif filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.tiff filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.png filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.gpkg filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.glb filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.bin filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.obj filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.ply filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.stl filter=lfs diff=lfs merge=lfs -text
