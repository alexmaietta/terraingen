/// @file
/// @brief The library version and API version, configured by CMake.
#pragma once

namespace terraingen {

#define TERRAINGEN_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define TERRAINGEN_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define TERRAINGEN_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define TERRAINGEN_VERSION_STRING "@PROJECT_VERSION@"
/// The version with any pre-release part, such as 0.1.0.dev42, as the Python package carries it.
#define TERRAINGEN_FULL_VERSION_STRING "@TERRAINGEN_FULL_VERSION@"

#define TERRAINGEN_API_VERSION 1

/// @brief A semantic version number.
struct Version {
    int major;  ///< Major version.
    int minor;  ///< Minor version.
    int patch;  ///< Patch version.
};

/// @brief The version of the linked library.
/// @return Major, minor and patch numbers.
Version GetVersion();

/// @brief The API version of the linked library.
/// @return `TERRAINGEN_API_VERSION` as compiled into the library.
int GetApiVersion();

}  // namespace terraingen
