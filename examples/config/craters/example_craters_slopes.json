{
    "schema_version": 1,
    "layers": [
        {
            "type": "noise",
            "stack": [
                {
                    "seed": 2,
                    "wavelength": 600,
                    "amplitude": 80,
                    "octaves": 6
                }
            ]
        },
        {
            "type": "craters",
            "seed": 1,
            "density": {
                "type": "trask"
            },
            "min_diameter": 20,
            "max_diameter": 300,
            "apply": {
                "datum": "plane",
                "slope": {
                    "enabled": true,
                    "upslope_rim": 0.1
                }
            }
        }
    ],
    "outputs": [
        {
            "type": "heightmap",
            "path": "example_craters_slopes.tif",
            "region": {
                "width": 513,
                "height": 513,
                "pixel_size": 2
            }
        }
    ]
}
