{
    "schema_version": 1,
    "source": {
        "type": "flat",
        "width": 513,
        "height": 513,
        "pixel_size": 2
    },
    "layers": [
        {
            "type": "noise",
            "stack": [
                {
                    "seed": 1,
                    "wavelength": 800,
                    "amplitude": 40,
                    "octaves": 8
                }
            ]
        },
        {
            "type": "craters",
            "seed": 1,
            "density": {
                "type": "lunar_surface",
                "age_gyr": 3.5
            },
            "min_diameter": 8,
            "max_diameter": 300,
            "ages": {
                "type": "fresh"
            },
            "degradation": {
                "type": "diffusion",
                "diffusivity": "fassett_2022_hartmann"
            }
        }
    ],
    "outputs": [
        {
            "type": "heightmap",
            "path": "example_ages_fresh.tif"
        },
        {
            "type": "crater_list",
            "path": "example_ages_fresh.csv"
        }
    ]
}
