{
    "schema_version": 1,
    "layers": [
        {
            "type": "noise",
            "stack": [
                {
                    "seed": 1,
                    "wavelength": 800,
                    "amplitude": 40,
                    "octaves": 8
                }
            ]
        },
        {
            "type": "scale",
            "scale": 1.5,
            "offset": -10
        },
        {
            "type": "clamp",
            "min": -15,
            "max": 30
        }
    ],
    "outputs": [
        {
            "type": "heightmap",
            "path": "example_layers_scale_and_clamp.tif",
            "pixel_size_m": 2,
            "extent_m": {
                "center": [
                    0,
                    0
                ],
                "size": [
                    1026,
                    1026
                ]
            }
        }
    ]
}
