{
    "schema_version": 1,
    "layers": [
        {
            "type": "noise",
            "stack": [
                {
                    "seed": 1,
                    "wavelength": 800,
                    "amplitude": 40,
                    "octaves": 8
                }
            ]
        },
        {
            "type": "scale",
            "scale": 1.5,
            "offset": -10
        },
        {
            "type": "clamp",
            "min": -15,
            "max": 30
        }
    ],
    "outputs": [
        {
            "type": "heightmap",
            "path": "example_layers_scale_and_clamp.tif",
            "region": {
                "width": 513,
                "height": 513,
                "pixel_size": 2
            }
        }
    ]
}
